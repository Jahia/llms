    "marked": "18.2.1",
    "prop-types": "^15.7.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "^12.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.13.10",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
