    "@cyclonedx/webpack-plugin": "^5.3.3",
    "@jahia/eslint-config": "^1.1.0",
    "@jahia/webpack-config": "^1.1.0",
    "babel-loader": "^10.1.1",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "eslint": "^6.8.0",
    "eslint-plugin-jest": "^23.3.0",
