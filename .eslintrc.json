{
  "extends": "@jahia",
  "rules": {
    "react/boolean-prop-naming": [
      1,
      {
        "rule": "^(is|has)[A-Z]([A-Za-z0-9]?)+"
      }
    ],
    "template-curly-spacing": "off",
    "indent": [
      "error",
      4,
      {
        "ignoredNodes": [
          "JSXElement *",
          "JSXElement",
          "TemplateLiteral"
        ],
        "SwitchCase": 1
      }
    ]
  },
  "globals": {
    "globalThis": "readonly"
  }
}
